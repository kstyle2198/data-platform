{
  "realm": "hdaic",
  "enabled": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "usage-api",
      "name": "Usage API",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8000/*"
      ],
      "webOrigins": [
        "http://localhost:8000"
      ],
      "protocolMappers": [
        {
          "name": "usage-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "usage-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "kim",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Kim",
      "lastName": "User",
      "email": "kim@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "test1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user"
      }
    ]
  }
}
